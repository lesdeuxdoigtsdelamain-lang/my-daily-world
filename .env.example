# NAMES / PLACEHOLDERS ONLY. Set the first two in GitHub Actions repository SECRETS.
CLOUDFLARE_ACCOUNT_ID=replace_in_github_secrets
CLOUDFLARE_API_TOKEN=replace_in_github_secrets
# Repository VARIABLES (not secrets):
AI_PROVIDER=cloudflare
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
